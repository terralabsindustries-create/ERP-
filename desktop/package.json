{
  "name": "terralabs-erp-desktop",
  "version": "1.1.0",
  "private": true,
  "//productName": "Electron uses this for app.getPath('userData'); migration from Terralabs ERP and SerpY is handled in main.cjs.",
  "productName": "Carbon",
  "description": "Carbon desktop shell — wraps the web client, does not fork it",
  "author": "Carbon",
  "main": "main.cjs",
  "scripts": {
    "build:renderer": "npm --prefix ../client run build:desktop",
    "start": "npm run build:renderer && electron .",
    "dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:8080 electron .",
    "dist": "npm run build:renderer && node build/embed-config.cjs && electron-builder",
    "dist:mac": "npm run build:renderer && node build/embed-config.cjs && electron-builder --mac",
    "dist:win": "npm run build:renderer && node build/embed-config.cjs && electron-builder --win",
    "pack": "npm run build:renderer && node build/embed-config.cjs && electron-builder --dir"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "in.serpy.erp",
    "productName": "Carbon",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "backend-runner.cjs",
      "resolve-request-path.cjs",
      "updater.cjs"
    ],
    "extraResources": [
      {
        "from": "../client/dist-desktop",
        "to": "app-dist"
      },
      {
        "from": "../backend/src",
        "to": "backend/src"
      },
      {
        "from": "../backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!puppeteer/.local-chromium/**",
          "!**/*.map",
          "!**/test/**",
          "!**/tests/**"
        ]
      },
      {
        "from": "build/app.env",
        "to": "app.env"
      }
    ],
    "afterPack": "build/adhoc-sign.cjs",
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Carbon-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Akbarhaleel1",
        "repo": "serpy-releases",
        "releaseType": "release"
      }
    ],
    "artifactName": "Carbon-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
