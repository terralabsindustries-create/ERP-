# Settings for the Electron desktop build (`vite build --mode desktop`).
# Vite gives `.env.desktop` priority over `.env.local`, so the desktop bundle
# never inherits a localhost API URL from a developer machine.

# The packaged app has no dev server to fall back on — this must be a reachable
# public API, and must not end in a slash.
VITE_API_URL=https://api.serpy.in/api

VITE_FACEBOOK_APP_ID=1076724650669349
VITE_WHATSAPP_CONFIG_ID=1021653400474138
